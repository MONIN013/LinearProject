  <DUT Name="DUT_CommandMailbox" Id="{9f95b821-e6f9-4e51-98dd-900047a01003}">
    <Declaration><![CDATA[TYPE DUT_CommandMailbox : STRUCT
    // command_id: 1=prepare_protocol, 2=start_protocol, 3=abort_protocol, 4=reset
    command_id                : UINT;
    request_id                : UDINT;
    lease_id                  : UDINT;
    protocol_id               : UINT;

    last_accepted_request_id  : UDINT;
    last_rejected_request_id  : UDINT;
    rejection_reason          : STRING(80);
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
